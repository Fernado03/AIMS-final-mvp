# Configuration for AIMS Medical Scribe Application
# Copy this file to .env and configure as needed

# ============================================================
# Vertex AI Settings (Required for AI-assisted note generation)
# ============================================================
# You need a Google Cloud account with Vertex AI enabled
# Get your credentials from: https://console.cloud.google.com/

GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account.json
VERTEX_AI_PROJECT_ID=your-project-id
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL_NAME=gemini-2.5-flash-lite

# ============================================================
# Whisper Speech-to-Text Settings (Local processing, no cloud needed)
# ============================================================
# Model options: tiny, base, small, medium, large
# - tiny/base: Fastest, less accurate
# - small: Good balance
# - medium: Recommended for medical use (better accuracy)
# - large: Highest accuracy, slowest

WHISPER_MODEL=medium
WHISPER_LANGUAGE=en

# ============================================================
# Database Settings
# ============================================================
DATABASE_NAME=notes_main.db
